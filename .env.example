# TinaCMS — leave CLIENT_ID/TOKEN empty to run in local mode (no cloud account
# needed for development: the CMS reads and writes the files in src/content).
TINA_CLIENT_ID=
TINA_TOKEN=

# TinaCloud indexes content PER BRANCH, and `tinacms build` bakes this value into
# tina/__generated__/client.ts — it is NOT read at runtime. Building a branch
# against another branch's index fails when their schemas differ.
TINA_BRANCH=staging

# Cloudflare Turnstile — PUBLIC site key (Vite inlines it at build time).
# Cloudflare's always-passes test key for local dev: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Subpath deploys only: DEPLOY_BASE=/subpath. Empty = site at the root.
DEPLOY_BASE=

# Absolute domain of the build (canonicals, sitemap, robots.txt, JSON-LD, share links).
# Empty = on Amplify it is derived from AWS_APP_ID + AWS_BRANCH / AWS_PULL_REQUEST_ID;
# anywhere else it falls back to https://medicaldigitalperu.com.
# Set it only for a custom domain, e.g. SITE_URL=https://staging.medicaldigitalperu.com
SITE_URL=
