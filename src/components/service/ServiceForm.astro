---
import ServiceFormReact from "./ServiceFormReact";

interface Props {
  query: string;
  variables: object;
  data: any;
  whatsappUrl: string;
}

const { query, variables, data, whatsappUrl } = Astro.props;
---

<ServiceFormReact query={query} variables={variables} data={data} whatsappUrl={whatsappUrl} client:visible />
