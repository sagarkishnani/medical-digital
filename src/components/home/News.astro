---
import NewsReact from "./NewsReact";
import type { NewsPost } from "./NewsReact";
import type { PostConnectionQuery } from "../../../tina/__generated__/types";
import { mediaUrl } from "../../utils/mediaUrl";

interface Props {
  query: string;
  variables: object;
  data: any;
  posts: PostConnectionQuery;
}

const { query, variables, data } = Astro.props;
const base = import.meta.env.BASE_URL || "/";
const dateFormat = new Intl.DateTimeFormat("es-PE", { day: "numeric", month: "short", year: "numeric" });

const posts: NewsPost[] = (Astro.props.posts.postConnection?.edges || [])
  .map((edge) => edge?.node)
  .filter((node): node is NonNullable<typeof node> => Boolean(node))
  .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime())
  .slice(0, 3)
  .map((post) => ({
    href: `${base}blog/${post._sys.filename}`,
    title: post.title,
    excerpt: post.excerpt || "",
    image: post.coverImage ? mediaUrl(post.coverImage) : "",
    tag: post.tags?.find(Boolean) || "",
    date: post.date ? dateFormat.format(new Date(post.date)) : "",
    readTime: post.readTime || "",
  }));
---

<NewsReact query={query} variables={variables} data={data} posts={posts} client:tina />
