---
import type { WooCategory } from "../../lib/woo/types";

interface Props {
  categories: WooCategory[];
  activeSlug?: string;
}

const { categories, activeSlug } = Astro.props;
const base = import.meta.env.BASE_URL || "/";

const items = [
  { label: "Todas", href: `${base}productos`, active: !activeSlug },
  ...categories
    .filter((category) => category.count > 0)
    .map((category) => ({
      label: category.name,
      href: `${base}productos/categoria/${category.slug}`,
      active: category.slug === activeSlug,
    })),
];
---

<nav aria-label="Categorías de productos">
  <ul class="flex flex-wrap gap-3">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? "page" : undefined}
          class:list={[
            "inline-flex h-10 items-center rounded-pill border px-5 text-body-sm font-medium transition-colors",
            item.active
              ? "border-brand-secondary-dark bg-brand-secondary-dark text-white"
              : "border-line bg-surface text-content hover:border-brand-secondary-dark",
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
