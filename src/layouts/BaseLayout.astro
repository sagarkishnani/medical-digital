---
/**
 * Base layout: <head>, site chrome and the global content every page needs.
 *
 * Pages pass `title`/`description` to override the SEO defaults coming from the
 * `global` collection. The locale is computed HERE and passed down as a prop:
 * islands must not read Astro.currentLocale themselves.
 */
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import client from "../../tina/__generated__/client";
import { ClientRouter } from "astro:transitions";
import { getLocale, tField } from "../utils/i18n";
import { isLocale } from "../i18n/config";
import "../styles/global.css";
import CookieConsent from "../components/cookies/CookieConsent.astro";
import WhatsAppButton from "../components/shared/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
  viewTransitions?: boolean;
  hideWhatsAppButton?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  article?: { publishedTime?: string; section?: string };
  jsonLd?: object[];
}

const {
  title,
  description,
  viewTransitions = true,
  hideWhatsAppButton = false,
  ogImage: pageOgImage,
  ogType = "website",
  article,
  jsonLd: pageJsonLd = [],
} = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

// ─── Global content (nav, footer, SEO defaults, code injection) ───
let globalData: any = null;
try {
  const result = await client.queries.global({ relativePath: "index.json" });
  globalData = result.data?.global;
} catch {
  // Collection not indexed yet: render with the component defaults.
}

const seoTitle = title || tField(globalData?.seo, "title", locale) || "Medical Digital";
const seoDescription =
  description || tField(globalData?.seo, "description", locale) || "Medical Digital cuida la salud del Perú con tecnología médica de marcas líderes en diagnóstico y soporte vital.";
const siteUrl = Astro.site || "https://medicaldigitalperu.com";
const ogImageSource = pageOgImage || globalData?.seo?.ogImage || "";
const ogImage = ogImageSource ? new URL(ogImageSource, siteUrl).href : "";
const injectHead = globalData?.codeInjection?.head || "";
const injectBodyEnd = globalData?.codeInjection?.bodyEnd || "";

const canonical = new URL(Astro.url.pathname, siteUrl).href;

/**
 * Datos estructurados. El estándar pide `Organization` en todo sitio; las
 * páginas que necesiten más (Product, Article, BreadcrumbList) lo añaden por su
 * cuenta, no aquí.
 *
 * El logo y las redes salen del CMS cuando están: Google los usa para el panel
 * de conocimiento, y un campo vacío es peor que ausente, así que se filtran.
 */
const orgSocials = (globalData?.footer?.social || [])
  .map((s: any) => s?.url)
  .filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Medical Digital",
  url: Astro.site?.href || "https://medicaldigitalperu.com",
  description: seoDescription,
  email: "info@medicaldigitalperu.com",
  ...(globalData?.nav?.logo ? { logo: new URL(globalData.nav.logo, Astro.site || "https://medicaldigitalperu.com").href } : {}),
  ...(orgSocials.length ? { sameAs: orgSocials } : {}),
};

// ─── Maintenance mode ───
// When enabled, the whole page body is replaced by a branded notice. Checked at
// build time, so flipping it in the CMS takes effect on the next publish.
let maintenance: any = null;
try {
  const result = await client.queries.maintenance({ relativePath: "index.json" });
  maintenance = result.data?.maintenance?.enabled ? result.data.maintenance : null;
} catch {
  // Collection missing: never in maintenance.
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pageJsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&family=Space+Mono:wght@300;400;500;600;700&display=swap" />

    {viewTransitions && <ClientRouter />}
    <Fragment set:html={injectHead} />
  </head>
  <body>
    {maintenance ? (
      <main class="flex min-h-screen items-center justify-center px-6 text-center">
        <div class="max-w-xl">
          <h1 class="text-heading-lg">{maintenance.title || "Estamos en mantenimiento"}</h1>
          <p class="mt-4 text-body-lg text-content-muted">
            {maintenance.message || "Volvemos en unos minutos."}
          </p>
          {maintenance.showContact && (
            <a class="btn-primary mt-8" href={maintenance.contactUrl || "/"}>
              {maintenance.contactText || "Contáctanos"}
            </a>
          )}
        </div>
      </main>
    ) : (
      <>
        <Header locale={locale} />
        <main>
          <slot />
        </main>
        <Footer locale={locale} />
        {globalData?.whatsappButton?.enabled && globalData?.whatsapp && <WhatsAppButton phone={globalData.whatsapp} desktopOnly={hideWhatsAppButton} />}
        <CookieConsent />
      </>
    )}
    <Fragment set:html={injectBodyEnd} />
    <script>
      // Lenis: inertial smooth scrolling. Skipped for visitors who asked for
      // reduced motion, and re-initialised after every View Transition.
      import Lenis from "lenis";

      let lenis: any = null;

      function startLenis() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        lenis?.destroy();
        lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        (window as unknown as { lenis: unknown }).lenis = lenis;
        const raf = (time: number) => {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      startLenis();
      document.addEventListener("astro:after-swap", startLenis);
    </script>
  </body>
</html>
