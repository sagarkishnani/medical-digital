---
import type { GetStaticPaths } from "astro";
import CatalogPage from "../../../components/productos/CatalogPage.astro";
import { getCategories } from "../../../lib/woo/store";
import type { WooCategory } from "../../../lib/woo/types";

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories
    .filter((category) => category.count > 0)
    .map((category) => ({ params: { slug: category.slug }, props: { category } }));
}) satisfies GetStaticPaths;

interface Props {
  category: WooCategory;
}

const { category } = Astro.props;
---

<CatalogPage
  title={category.name}
  seoTitle={`${category.name} — Productos — Medical Digital`}
  seoDescription={`Equipos médicos de ${category.name} de marcas líderes. Solicita tu cotización a Medical Digital.`}
  category={category}
/>
