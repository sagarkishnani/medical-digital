---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSlider from "../components/home/HomeSlider.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import Specialties from "../components/home/Specialties.astro";
import HomeAbout from "../components/home/HomeAbout.astro";
import Brands from "../components/home/Brands.astro";
import Testimonials from "../components/home/Testimonials.astro";
import News from "../components/home/News.astro";
import client from "../../tina/__generated__/client";
import { getCategories, getFeaturedProducts } from "../lib/woo/store";

const { query, variables, data } = await client.queries.home({ relativePath: "index.json" });
const [global, posts, featuredProducts, categories] = await Promise.all([
  client.queries.global({ relativePath: "index.json" }),
  client.queries.postConnection(),
  getFeaturedProducts(data.home.featured?.limit || 4),
  getCategories(),
]);
const whatsappNumber = global.data.global.whatsapp || "";
const companyEmails = (global.data.global.company?.emails || []).filter((email): email is string => Boolean(email));
const salesEmail = companyEmails.find((email) => email.startsWith("ventas@")) || companyEmails[0] || "";
const seo = data.home.seo;
const section = { query, variables, data };
---

<BaseLayout title={seo?.title} description={seo?.description}>
  <HomeSlider {...section} />
  <FeaturedProducts {...section} products={featuredProducts} whatsappNumber={whatsappNumber} salesEmail={salesEmail} />
  <Specialties {...section} categories={categories} />
  <HomeAbout {...section} />
  <Brands {...section} />
  <Testimonials {...section} />
  <News {...section} posts={posts.data} />
</BaseLayout>
