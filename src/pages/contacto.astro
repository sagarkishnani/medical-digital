---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactHero from "../components/contact/ContactHero.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactInfo from "../components/contact/ContactInfo.astro";
import ContactMap from "../components/contact/ContactMap.astro";
import client from "../../tina/__generated__/client";

const [contact, global] = await Promise.all([
  client.queries.contact({ relativePath: "contacto.json" }),
  client.queries.global({ relativePath: "index.json" }),
]);
const seo = contact.data.contact.seo;
const contactSection = { query: contact.query, variables: contact.variables, data: contact.data };
const globalSection = { query: global.query, variables: global.variables, data: global.data };
---

<BaseLayout title={seo?.title} description={seo?.description}>
  <ContactHero {...contactSection} />
  <section class="bg-surface-raised">
    <div class="container-xl grid items-start gap-12 pb-24 pt-16 md:pt-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-16">
      <ContactForm {...contactSection} />
      <ContactInfo {...globalSection} />
    </div>
  </section>
  <ContactMap {...contactSection} />
</BaseLayout>
