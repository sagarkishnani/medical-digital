---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostBody from "../../components/blog/PostBody";
import NewsCard from "../../components/noticias/NewsCard";
import { toNewsCard } from "../../components/noticias/buildNewsCards";
import client from "../../../tina/__generated__/client";
import { mediaUrl } from "../../utils/mediaUrl";
import { withBase } from "../../utils/url";
import { buildAdvisorUrl } from "../../utils/whatsapp";
import { NEWS_AUTHOR, categorySlug, formatNewsDate, readingMinutes, sortByDate } from "../../utils/news";

export async function getStaticPaths() {
  const result = await client.queries.postConnection();
  return (result.data?.postConnection?.edges || [])
    .map((edge) => edge?.node)
    .filter((node): node is NonNullable<typeof node> => Boolean(node))
    .map((post) => ({ params: { slug: post._sys.filename } }));
}

const RELATED_COUNT = 3;
const { slug } = Astro.params;

const [postResult, connectionResult, globalResult] = await Promise.all([
  client.queries.post({ relativePath: `${slug}.mdx` }),
  client.queries.postConnection(),
  client.queries.global({ relativePath: "index.json" }).catch(() => null),
]);

const post = postResult.data.post;
const global = globalResult?.data?.global;
const siteUrl = Astro.site || "https://medicaldigitalperu.com";
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const allPosts = sortByDate(
  (connectionResult.data?.postConnection?.edges || [])
    .map((edge) => edge?.node)
    .filter((node): node is NonNullable<typeof node> => Boolean(node)),
);
const related = allPosts
  .filter((item) => item._sys.filename !== slug)
  .slice(0, RELATED_COUNT)
  .map(toNewsCard);

const category = post.category || "";
const author = post.author?.trim() || NEWS_AUTHOR;
const date = post.date ? formatNewsDate(post.date) : "";
const readTime = `${readingMinutes(post.body)} min`;
const cover = mediaUrl(post.coverImage);
const coverAbsolute = cover ? new URL(cover, siteUrl).href : "";
const newsHref = withBase("/noticias");
const categoryHref = `${newsHref}?categoria=${categorySlug(category)}`;

const seoTitle = post.seo?.title?.trim() || `${post.title} | Medical Digital`;
const seoDescription = post.seo?.description?.trim() || post.excerpt;

const organization = {
  "@type": "Organization",
  name: "Medical Digital",
  url: new URL(withBase("/"), siteUrl).href,
  ...(global?.nav?.logo ? { logo: new URL(mediaUrl(global.nav.logo), siteUrl).href } : {}),
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: seoDescription,
    ...(coverAbsolute ? { image: coverAbsolute } : {}),
    ...(post.date ? { datePublished: post.date } : {}),
    author: post.author?.trim() ? { "@type": "Person", name: post.author.trim() } : organization,
    publisher: organization,
    mainEntityOfPage: canonical,
    ...(category ? { articleSection: category } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(withBase("/"), siteUrl).href },
      { "@type": "ListItem", position: 2, name: "Noticias", item: new URL(`${newsHref}/`, siteUrl).href },
      { "@type": "ListItem", position: 3, name: post.title },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={cover || undefined}
  ogType="article"
  article={{ publishedTime: post.date || undefined, section: category || undefined }}
  jsonLd={jsonLd}
>
  <article>
    <header class="mx-auto flex max-w-[820px] flex-col gap-3.5 px-4 pb-5 pt-6 md:gap-[22px] md:px-8 md:pb-10 md:pt-12">
      <nav aria-label="Miga de pan">
        <ol class="flex flex-wrap items-center gap-2 text-[13px] text-content-subtle md:text-body-sm">
          <li class="hidden md:list-item"><a href={withBase("/")} class="-my-3 inline-block py-3">Inicio</a></li>
          <li aria-hidden="true" class="hidden md:list-item">/</li>
          <li><a href={newsHref} class="-my-3 inline-block py-3">Noticias</a></li>
          {category && (
            <>
              <li aria-hidden="true">/</li>
              <li><a href={categoryHref} class="-my-3 inline-block py-3 text-brand-secondary-dark">{category}</a></li>
            </>
          )}
        </ol>
      </nav>
      {category && (
        <span class="self-start rounded-pill bg-brand-tertiary-lightest px-2.5 py-1 text-caption font-medium text-brand-tertiary-dark md:px-3 md:text-[13px]">
          {category}
        </span>
      )}
      <h1 class="text-[28px] font-medium leading-[1.2] text-brand-secondary-dark text-balance md:text-[46px] md:leading-[1.15]">{post.title}</h1>
      <div class="flex items-center justify-between gap-4 border-y border-line py-3 md:py-[18px]">
        <div class="flex items-center gap-2.5 md:gap-3">
          <div aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-secondary-dark text-[13px] font-medium text-white md:h-11 md:w-11 md:text-body-sm">MD</div>
          <div class="flex flex-col gap-0.5">
            <span class="text-body-sm font-medium text-brand-secondary-dark">{author}</span>
            <span class="text-caption text-content-subtle md:text-[13px]">
              {post.date && <time datetime={post.date}>{date}</time>} · {readTime}<span class="hidden md:inline"> de lectura</span>
            </span>
          </div>
        </div>
      </div>
    </header>

    {cover && (
      <div class="mx-auto max-w-[1120px] px-4 md:px-8">
        <div class="aspect-[16/10] overflow-hidden rounded-[20px] bg-surface-raised md:aspect-[16/8] md:rounded-[28px]">
          <img src={cover} alt="" width={1120} height={560} fetchpriority="high" class="h-full w-full object-cover" />
        </div>
      </div>
    )}

    <div class="mx-auto flex max-w-[720px] flex-col gap-[18px] px-4 pb-10 pt-7 md:gap-[22px] md:px-8 md:pb-20 md:pt-12">
      <p class="text-[18px] leading-[1.6] text-brand-secondary-dark md:text-[21px]">{post.excerpt}</p>
      <PostBody content={post.body} />
      <div class="mt-2 flex flex-col gap-3.5 rounded-[20px] bg-brand-secondary-dark p-[22px] text-white md:mt-5 md:flex-row md:items-center md:justify-between md:gap-5 md:rounded-2xl md:px-8 md:py-7">
        <p class="text-[18px] font-medium leading-[1.35] md:text-[19px]">¿Te ayudamos a elegir el equipo ideal?</p>
        <button
          type="button"
          data-quote-name="Asesoría comercial"
          data-quote-url={buildAdvisorUrl(global?.whatsapp || "")}
          aria-haspopup="dialog"
          class="btn-primary h-[50px] shrink-0 whitespace-nowrap"
        >
          Hablar con un asesor
        </button>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="hidden bg-surface-raised md:block" aria-labelledby="sigue-leyendo">
      <div class="container-xl flex flex-col gap-8 py-20">
        <h2 id="sigue-leyendo" class="text-heading-h2 text-brand-secondary-dark">Sigue leyendo</h2>
        <ul class="grid grid-cols-2 gap-7 lg:grid-cols-3">
          {related.map((item) => (
            <li><NewsCard post={item} variant="related" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
